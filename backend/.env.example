# ============================================
# AI Investigation Copilot — Environment Config
# ============================================

# --- Application ---
APP_NAME="AI Investigation Copilot API"
ENV=development

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investigation_db

# --- API authentication ---
# Shared secret required on protected routes via the X-API-Key header.
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The frontend needs the SAME value in frontend/.env.local (also as
# API_SHARED_SECRET, never as NEXT_PUBLIC_*).
API_SHARED_SECRET=your-shared-secret-here

# --- Gemini / LLM ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.7-flash
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=1
GROQ_BACKOFF_BASE_SECONDS=0.5
GROQ_BACKOFF_MAX_SECONDS=8
GROQ_STRUCTURED_CORRECTION_RETRIES=1
