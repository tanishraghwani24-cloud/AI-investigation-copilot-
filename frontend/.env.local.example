# Copy to .env.local (gitignored) and fill in real values for local dev.

# Required — must match backend/.env's API_SHARED_SECRET exactly.
# Server-only: never rename this with a NEXT_PUBLIC_ prefix, or it will be
# bundled into browser JS and exposed to every visitor.
API_SHARED_SECRET=your-shared-secret-here

# Optional — where the Next.js server and its /api/proxy route reach the
# FastAPI backend. Defaults to http://127.0.0.1:8000/api if unset.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000/api
